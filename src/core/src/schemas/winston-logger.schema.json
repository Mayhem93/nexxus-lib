{
  "$id": "nexxus-winston-logger",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error", "critical", "alert", "emerg"],
      "default": "info"
    },
    "logType": {
      "type": "string",
      "enum": ["text", "json"],
      "default": "text"
    },
    "timestamps": {
      "type": "boolean",
      "default": true
    },
    "colors": {
      "type": "boolean",
      "default": false
    },
    "transports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/StdoutTransport" },
          { "$ref": "#/definitions/FileTransport" },
          { "$ref": "#/definitions/CustomTransport" }
        ]
      }
    }
  },
  "required": [
    "level",
    "logType"
  ],
  "definitions": {
    "StdoutTransport": {
      "type": "object",
      "properties": {
        "type": { "const": "stdout" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "FileTransport": {
      "type": "object",
      "properties": {
        "type":     { "const": "file" },
        "filename": { "type": "string" },
        "maxSize":  { "type": "number" },
        "maxFiles": { "type": "number" }
      },
      "required": ["type", "filename"],
      "additionalProperties": false
    },
    "CustomTransport": {
      "type": "object",
      "properties": {
        "type":    { "type": "string", "not": { "enum": ["stdout", "file"] } },
        "export":  { "type": "string" },
        "options": { "type": "object" }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  }
}
