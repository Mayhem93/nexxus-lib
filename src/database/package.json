{
  "name": "@mayhem93/nexxus-database-lib",
  "version": "0.0.4",
  "description": "Database adapters for Nexxus",
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "types": "dist-types/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "concurrently \"npm run build:cjs\" \"npm run build:esm\" \"npm run build:types\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:cjs": "tsc -p tsconfig.cjs.json"
  },
  "sideEffects": false,
  "files": [
    "dist-*/**",
    "src/schemas/**/*.json"
  ],
  "homepage": "https://github.com/Mayhem93/nexxus-lib/tree/main/src/database",
  "keywords": [
    "realtime",
    "sync",
    "synchronization",
    "notifications",
    "backend",
    "baas"
  ],
  "author": "Răzvan Botea <contact@razvanbotea.me>",
  "license": "MPL-2.0",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@mayhem93/nexxus-core-lib": "0.0.4",
    "@types/argparse": "^2.0.17",
    "@types/json-schema": "^7.0.15",
    "ajv": "^8.17.1",
    "argparse": "^2.0.1",
    "deepmerge": "^4.3.1",
    "dot-prop": "^10.1.0",
    "tslib": "2.8.1",
    "winston": "^3.18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mayhem93/nexxus-lib.git",
    "directory": "src/database"
  }
}
