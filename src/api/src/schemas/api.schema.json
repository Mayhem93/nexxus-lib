{
  "$id": "nexxus-api",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "port": {
      "type": "number",
      "default": 5000
    },
    "logger": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "message_queue": {
      "type": "string"
    },
    "maxBodySize": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 1048576,
      "default": 65536
    },
    "trustProxy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 0
    },
    "cors": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|https?://[^/\\s?#]+)$" },
          "uniqueItems": true,
          "default": []
        }
      },
      "default": {}
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "factor": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        }
      },
      "default": {}
    },
    "ssl": {
      "type": "object",
      "properties": {
        "sslKeyPath": {
          "type": "string"
        },
        "sslCertPath": {
          "type": "string"
        }
      },
      "required": [ "sslKeyPath", "sslCertPath" ]
    },
    "auth": {
      "type": "object",
      "properties": {
        "availableStrategies": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [ "availableStrategies" ]
    },
    "management": {
      "type": "object",
      "properties": {
        "port":  { "type": "number" },
        "token": { "type": "string" }
      },
      "required": [ "port", "token" ]
    },
    "hub": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "token":    { "type": "string" }
      },
      "required": [ "endpoint", "token" ]
    }
  },
  "required": [
    "name",
    "logger",
    "database",
    "message_queue",
    "management"
  ]
}
