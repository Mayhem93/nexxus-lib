{
  "$id": "nexxus-api",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "port": {
      "type": "number",
      "default": 5000
    },
    "ssl": {
      "type": "object",
      "properties": {
        "sslKeyPath": {
          "type": "string"
        },
        "sslCertPath": {
          "type": "string"
        }
      },
      "required": [ "sslKeyPath", "sslCertPath" ]
    },
    "auth": {
      "type": "object",
      "properties": {
        "availableStrategies": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [ "availableStrategies" ]
    }
  },
  "required": [
    "name"
  ]
}
