{
  "type": "object",
  "properties": {
    "port": {
      "type": "number"
    },
    "ssl": {
      "type": "object",
      "properties": {
        "sslKeyPath": {
          "type": "string"
        },
        "sslCertPath": {
          "type": "string"
        }
      },
      "required": [ "sslKeyPath", "sslCertPath" ]
    },
    "heartbeatInterval": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 30
    },
    "maxMessageSize": {
      "type": "integer",
      "minimum": 16384,
      "maximum": 1048576,
      "default": 16384
    },
    "registerTimeout": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 30
    },
    "logger": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "message_queue": {
      "type": "string"
    },
    "management": {
      "type": "object",
      "properties": {
        "port":  { "type": "number" },
        "token": { "type": "string" }
      },
      "required": [ "port", "token" ]
    },
    "hub": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "token":    { "type": "string" }
      },
      "required": [ "endpoint", "token" ]
    }
  },
  "required": [
    "port",
    "logger",
    "database",
    "message_queue",
    "management"
  ]
}
