{
  "type": "object",
  "properties": {
    "port": {
      "type": "number"
    },
    "heartbeatInterval": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 30
    },
    "logger": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "message_queue": {
      "type": "string"
    },
    "management": {
      "type": "object",
      "properties": {
        "port":  { "type": "number" },
        "token": { "type": "string" }
      },
      "required": [ "port", "token" ]
    },
    "hub": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "token":    { "type": "string" }
      },
      "required": [ "endpoint", "token" ]
    }
  },
  "required": [
    "port",
    "logger",
    "database",
    "message_queue",
    "management"
  ]
}
