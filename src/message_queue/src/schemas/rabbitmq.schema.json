{
  "type": "object",
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "number"
    },
    "user": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "managementPort": {
      "type": "number",
      "default": 15672
    },
    "prefetch": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "publishTimeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 5
    },
    "deadLetterRetention": {
      "type": "integer",
      "minimum": 259200,
      "maximum": 2592000,
      "default": 259200
    },
    "deadLetterMaxLength": {
      "type": "integer",
      "minimum": 10,
      "maximum": 500,
      "default": 100
    },
    "compression": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "algo": {
          "type": "string",
          "enum": ["lz4"]
        },
        "options": { "type": "object", "default": {} }
      },
      "required": ["enabled", "algo"],
      "additionalProperties": false
    }
  },
  "required": [
    "host",
    "port",
    "user",
    "password"
  ]
}
