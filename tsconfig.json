{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "importHelpers": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noEmitHelpers": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@mayhem93/nexxus-core-lib": ["./src/core/*"],
      "@mayhem93/nexxus-database-lib": ["./src/database/*"],
      "@mayhem93/nexxus-message-queue-lib": ["./src/message_queue/*"],
      "@mayhem93/nexxus-redis": ["./src/redis/*"],
      "@mayhem93/nexxus-worker-lib": ["./src/worker/*"]
    },
    "preserveConstEnums": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "experimentalDecorators": true,
    "sourceMap": true
  },
  "include": ["src/"],
  "exclude": ["node_modules/", "**/*.spec.ts", "vitest.*.ts"]
}
